 struct sc8280xp_snd_data {
 	bool stream_prepared[AFE_PORT_MAX];
+	bool sdw_suspended[AFE_PORT_MAX];
 	struct snd_soc_card *card;
 	struct snd_soc_jack jack;
 	struct snd_soc_jack dp_jack[8];
 	bool jack_setup;
 	struct clk *i2s_clk;
 	int mi2s_clk_count;
 	bool mi2s_clk_suspended;
 };
 
 static int sc8280xp_snd_init(struct snd_soc_pcm_runtime *rtd)
 {
 	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
 	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	struct snd_soc_card *card = rtd->card;
 	struct snd_soc_jack *dp_jack  = NULL;
 	int dp_pcm_id = 0;
 
 	switch (cpu_dai->id) {
 	case PRIMARY_MI2S_RX...QUATERNARY_MI2S_TX:
 	case QUINARY_MI2S_RX...QUINARY_MI2S_TX:
@@ -179,54 +180,91 @@
 {
 	struct snd_soc_dai_link *link;
 	int i;
 
 	for_each_card_prelinks(card, i, link) {
 		if (link->no_pcm == 1) {
 			link->init = sc8280xp_snd_init;
 			link->be_hw_params_fixup = sc8280xp_be_hw_params_fixup;
 			link->ops = &sc8280xp_be_ops;
 		}
 
 		/* Nothing on these cards has to play across system suspend */
 		link->ignore_suspend = 0;
 	}
 }
 
 /* A PCM open at suspend keeps this q6prm clock, which holds LPASS and CX up */
 static int sc8280xp_snd_suspend_post(struct snd_soc_card *card)
 {
 	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(card);
+	struct snd_soc_pcm_runtime *rtd;
+	int dir;
+
+	for_each_card_rtds(card, rtd) {
+		struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+
+		if (!cpu_dai || cpu_dai->id >= AFE_PORT_MAX ||
+		    !data->stream_prepared[cpu_dai->id])
+			continue;
+		for_each_pcm_streams(dir) {
+			struct snd_pcm_substream *ss = snd_soc_dpcm_get_substream(rtd, dir);
+
+			if (ss && data->stream_prepared[cpu_dai->id]) {
+				qcom_snd_sdw_hw_free(ss, &data->stream_prepared[cpu_dai->id]);
+				data->sdw_suspended[cpu_dai->id] = !data->stream_prepared[cpu_dai->id];
+			}
+		}
+	}
 
 	snd_soc_dpcm_mutex_lock(card);
 	if (data->mi2s_clk_count)
 		clk_disable_unprepare(data->i2s_clk);
 	data->mi2s_clk_suspended = true;
 	snd_soc_dpcm_mutex_unlock(card);
 
 	return 0;
 }
 
 static int sc8280xp_snd_resume_pre(struct snd_soc_card *card)
 {
 	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(card);
 	int ret = 0;
+	struct snd_soc_pcm_runtime *rtd;
+	int dir;
+
+	for_each_card_rtds(card, rtd) {
+		struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+
+		if (!cpu_dai || cpu_dai->id >= AFE_PORT_MAX ||
+		    !data->sdw_suspended[cpu_dai->id])
+			continue;
+		data->sdw_suspended[cpu_dai->id] = false;
+		for_each_pcm_streams(dir) {
+			struct snd_pcm_substream *ss = snd_soc_dpcm_get_substream(rtd, dir);
+
+			if (ss && !data->stream_prepared[cpu_dai->id] &&
+			    qcom_snd_sdw_prepare(ss, &data->stream_prepared[cpu_dai->id]))
+				dev_warn(card->dev, "%s: SoundWire re-enable deferred to prepare\n",
+					 cpu_dai->name);
+		}
+	}
 
 	snd_soc_dpcm_mutex_lock(card);
 	data->mi2s_clk_suspended = false;
 	if (data->mi2s_clk_count)
 		ret = clk_prepare_enable(data->i2s_clk);
 	snd_soc_dpcm_mutex_unlock(card);
 	if (ret)
 		dev_err(card->dev, "failed to re-enable the I2S clock: %d\n", ret);
 
 	return 0;
 }
 
 static int sc8280xp_platform_probe(struct platform_device *pdev)
 {
 	struct snd_soc_card *card;
 	struct sc8280xp_snd_data *data;
 	struct device *dev = &pdev->dev;
 	int ret;
 
 	card = devm_kzalloc(dev, sizeof(*card), GFP_KERNEL);
