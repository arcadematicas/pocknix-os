#!/bin/bash
# pocknix-roms-init - login-time setup for the emulation layer, run as 'deck' by its user unit.
# Seeds go through pocknix-seed-merge. Every step is guarded: a failure must never fail a login.
set -u

SHARE=/usr/share/pocknix-emulation
MERGE=/usr/lib/pocknix/pocknix-seed-merge
EMUS=/opt/pocknix/emulators
EMU="${HOME}/Emulation"
MODE=add-only

# Seeds are authored for a 120Hz, 1080-line panel and adapted below; absent keys pass them through.
[ -r /usr/lib/pocknix/device.conf ] && . /usr/lib/pocknix/device.conf
[ -r /etc/pocknix/device.conf ] && . /etc/pocknix/device.conf
REFRESH="${POCKNIX_PANEL_REFRESH:-120}"
# device.conf carries the NATIVE frame; rotated panels are transposed to get the logical height.
case "${POCKNIX_PANEL_ORIENT:-left}" in
  left|right) LOGICAL_H="${POCKNIX_PANEL_W:-1080}" ;;
  *)          LOGICAL_H="${POCKNIX_PANEL_H:-1920}" ;;
esac
# ES-DE's ROMDirectory setting is the single source of truth for where ROMs live (the user can
# repoint it at an SD card); this skeleton and pocknix-steam-sync both follow it. Empty/absent
# means ES-DE's own default ~/ROMs. The settings file is a rootless XML fragment, hence sed.
ESDE_SETTINGS="${HOME}/ES-DE/settings/es_settings.xml"
ESDE_CUSTOM="${HOME}/ES-DE/custom_systems"
_roms_setting="$(sed -n 's/.*name="ROMDirectory" value="\([^"]*\)".*/\1/p' "${ESDE_SETTINGS}" 2>/dev/null | head -1)"
case "${_roms_setting}" in "~"*) _roms_setting="${HOME}${_roms_setting#\~}" ;; esac
if [ -n "${_roms_setting}" ]; then
  ROMS="${_roms_setting}"
elif [ -f "${ESDE_SETTINGS}" ]; then
  ROMS="${HOME}/ROMs"          # settings exist but no/empty ROMDirectory = ES-DE default
else
  ROMS="${EMU}/ROMs"           # fresh install: the seed below points ES-DE here
fi

# ES-DE's own default folder names - creating one only gives the user a labelled drop point;
# ES-DE still shows a system only once it is populated.
SYSTEMS=(
  nes snes n64 gb gbc gba nds n3ds
  genesis megadrive mastersystem gamegear segacd saturn dreamcast
  tg16 pcengine neogeo arcade mame
  atari2600 atari7800 atarilynx atarijaguar wonderswan
  psx ps2 ps3 psp psvita
  gc wii wiiu switch xbox
)

have_esde()      { command -v es-de >/dev/null 2>&1; }
have_retroarch() { command -v retroarch >/dev/null 2>&1; }
have_armsx2()    { [ -x "${EMUS}/armsx2/ARMSX2.AppImage" ]; }
have_eden()      { [ -x "${EMUS}/eden/Eden.AppImage" ]; }
have_dolphin()   { command -v dolphin-emu >/dev/null 2>&1; }
have_cemu()      { command -v Cemu >/dev/null 2>&1; }
have_ppsspp()    { command -v PPSSPPSDL >/dev/null 2>&1 || command -v ppsspp >/dev/null 2>&1; }
EMULATORS=(esde retroarch armsx2 eden dolphin cemu ppsspp)

# Rendered seeds live here for the helper; the merge helper compares them against the baseline
# it keeps under ~/.local/state/pocknix/seed-baseline.
TMP="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/pocknix-seed.XXXXXX")" || exit 0
trap 'rm -rf "${TMP}"' EXIT

have_merge() { command -v python3 >/dev/null 2>&1 && [ -x "${MERGE}" ]; }
seed_b() {  # $1 format, $2 rendered seed, $3 target
  mkdir -p "$(dirname "$3")" 2>/dev/null || return 0
  if have_merge; then
    "${MERGE}" --class b --format "$1" --mode "${MODE}" "$2" "$3" 2>&1 || true
  else
    [ -f "$3" ] || cp "$2" "$3" 2>/dev/null || true
  fi
}
seed_a() {  # $1 source file or dir, $2 target
  mkdir -p "$(dirname "$2")" 2>/dev/null || return 0
  if have_merge; then
    "${MERGE}" --class a "$1" "$2" 2>&1 || true
  elif [ -d "$1" ]; then
    mkdir -p "$2"; cp -Rn "$1/." "$2/" 2>/dev/null || true
  else
    [ -f "$2" ] || cp "$1" "$2" 2>/dev/null || true
  fi
}

seed_esde() {
  printf '<?xml version="1.0"?>\n<string name="ROMDirectory" value="%s" />\n' "${ROMS}" > "${TMP}/es_settings.xml"
  seed_b esxml "${TMP}/es_settings.xml" "${ESDE_SETTINGS}"
  seed_a "${SHARE}/es_find_rules.xml" "${ESDE_CUSTOM}/es_find_rules.xml"
  seed_a "${SHARE}/es_systems.xml" "${ESDE_CUSTOM}/es_systems.xml"
}

seed_retroarch() {
  # refresh/swap-interval are per-device: the seed's authored values (120Hz, interval 2 =
  # present-every-2nd-vblank) are right ONLY for 120Hz panels; on a 60Hz panel interval 2 paces
  # at 30fps. Substitute from POCKNIX_PANEL_REFRESH: 60Hz -> 60/1, 120Hz -> 120/2.
  _si=$(( REFRESH / 60 )); [ "${_si}" -lt 1 ] && _si=1
  sed -e "s/^video_refresh_rate = .*/video_refresh_rate = \"${REFRESH}.000000\"/" \
      -e "s/^video_swap_interval = .*/video_swap_interval = \"${_si}\"/" \
      "${SHARE}/retroarch.cfg" > "${TMP}/retroarch.cfg"
  seed_b racfg "${TMP}/retroarch.cfg" "${HOME}/.config/retroarch/retroarch.cfg"
  # Pad profiles from retroarch-autoconfig-pocknix go into RetroArch's default, WRITABLE
  # autoconfig dir so user-saved custom profiles coexist. Without them RetroArch sees Steam
  # Input's virtual X360 pad but has no bindings: controls fully dead.
  [ -d /usr/share/libretro/autoconfig/udev ] && \
    seed_a /usr/share/libretro/autoconfig/udev "${HOME}/.config/retroarch/autoconfig/udev"
  # Vendored slang shaders (retroarch-shaders-pocknix) are linked, not copied (79 MB): the
  # shader dir itself stays the writable user default so preset saving keeps working. Skipped
  # if the user already has a real shaders_slang (e.g. from the Online Updater).
  local shaders="${HOME}/.config/retroarch/shaders/shaders_slang"
  if [ -d /usr/share/libretro/shaders/shaders_slang ] && [ ! -e "${shaders}" ]; then
    mkdir -p "${HOME}/.config/retroarch/shaders"
    ln -s /usr/share/libretro/shaders/shaders_slang "${shaders}" 2>/dev/null || true
  fi
  # per-system tuning: content-dir overrides + shader presets (e.g. mGBA integer scale + lcd3x)
  [ -d "${SHARE}/retroarch-config" ] && \
    seed_a "${SHARE}/retroarch-config" "${HOME}/.config/retroarch/config"
}

seed_armsx2() {
  # ARMSX2 moved from PCSX2's stock ~/.config/PCSX2 to ~/.config/ARMSX2 (same tree layout
  # inside). The migration copy must precede the seed, or an upgraded device gets a fresh
  # seed, the setup wizard, and orphaned memcards/savestates.
  if [ -f "${HOME}/.config/PCSX2/inis/PCSX2.ini" ] && [ ! -f "${HOME}/.config/ARMSX2/inis/PCSX2.ini" ]; then
    mkdir -p "${HOME}/.config/ARMSX2"
    cp -a "${HOME}/.config/PCSX2/." "${HOME}/.config/ARMSX2/" 2>/dev/null || true
  fi
  sed "s|__HOME__|${HOME}|g" "${SHARE}/armsx2-PCSX2.ini.in" > "${TMP}/PCSX2.ini"
  seed_b ini "${TMP}/PCSX2.ini" "${HOME}/.config/ARMSX2/inis/PCSX2.ini"
}

seed_eden() {
  # vsync is per-device: Mailbox (1) on 120Hz panels, FIFO (2) on 60Hz ones, where Mailbox is
  # bouncy. The rest of the seed (pad bindings, 1x resolution) is authored.
  _vs=2; [ "${REFRESH}" -ge 120 ] 2>/dev/null && _vs=1
  sed "s/^use_vsync=.*/use_vsync=${_vs}/" "${SHARE}/eden-qt-config.ini.in" > "${TMP}/qt-config.ini"
  seed_b ini "${TMP}/qt-config.ini" "${HOME}/.config/eden/qt-config.ini"
}

seed_dolphin() {
  seed_b ini "${SHARE}/dolphin-Dolphin.ini.in" "${HOME}/.config/dolphin-emu/Dolphin.ini"
  seed_b ini "${SHARE}/dolphin-GFX.ini.in"     "${HOME}/.config/dolphin-emu/GFX.ini"
  seed_a "${SHARE}/dolphin-GCPadNew.ini.in"     "${HOME}/.config/dolphin-emu/GCPadNew.ini"
}

seed_cemu() {
  # settings.xml existing at all is what skips Cemu's onboarding wizard (CemuApp isFirstStart).
  # The controller profile is session-dependent, so pocknix-cemu-profile writes it at launch.
  sed "s|__ROMS__|${ROMS}|g" "${SHARE}/cemu-settings.xml.in" > "${TMP}/settings.xml"
  seed_b xml "${TMP}/settings.xml" "${HOME}/.config/Cemu/settings.xml"
}

seed_ppsspp() {
  # PPSSPP's "auto" scales with the window and lands inconsistently on rotated panels: pin the
  # largest 272-row multiple that fits the logical height (+8 rows slack: 4x on 1080 crops 8 rows).
  _res=$(( (LOGICAL_H + 8) / 272 )); [ "${_res}" -lt 1 ] && _res=1
  sed "s/^iInternalResolution = .*/iInternalResolution = ${_res}/" "${SHARE}/ppsspp.ini.in" > "${TMP}/ppsspp.ini"
  seed_b ini "${TMP}/ppsspp.ini" "${HOME}/.config/ppsspp/PSP/SYSTEM/ppsspp.ini"
}

present=()
for e in "${EMULATORS[@]}"; do "have_${e}" && present+=("${e}"); done
# nothing of the layer installed: no ~/Emulation, no emulator config dirs
[ "${#present[@]}" -gt 0 ] || exit 0

mkdir -p "${EMU}/BIOS" "${EMU}/Saves" "${EMU}/States"
for s in "${SYSTEMS[@]}"; do mkdir -p "${ROMS}/${s}"; done
# refreshed every run so doc updates reach existing installs
[ -f "${SHARE}/ROMS-README.txt" ] && cp -f "${SHARE}/ROMS-README.txt" "${EMU}/README.txt" 2>/dev/null

for e in "${present[@]}"; do "seed_${e}" || true; done
exit 0
