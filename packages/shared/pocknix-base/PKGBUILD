# pocknix-base — base-mode tooling for locked devices: the locked<->rolling
# switch and the desktop updater.
pkgname=pocknix-base
pkgver=0.2.0
# 6: pocknix-update stops being a bare `exec pacman -Syu`. It now runs -Syu with a bounded
#    --overwrite on the paths OUR packages own, and if pacman still reports conflicts it
#    retries ONCE with --overwrite narrowed to the exact paths pacman named that no
#    installed package owns. Without this, `pacman -Syu` aborted forever on the leftover
#    plutovg/plutosvg/libFLAC.so.8/libpcap.so.0.8/Valve-Turnip files pocknix wrote into
#    fielded devices outside pacman, so a user without a terminal could never update.
pkgrel=6
pkgdesc="Locked/rolling base mode switch and desktop updater for pocknix"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('MIT')
# base-lock rides along so `pocknix-base status` can always name the snapshot
depends=('pacman' 'pocknix-base-lock')
install=pocknix-base.install
source=('pocknix-base'
        'pocknix-update'
        'pocknix-update.desktop'
        '51-pocknix-update.rules')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "${srcdir}/pocknix-base" "${pkgdir}/usr/bin/pocknix-base"
  # /usr/bin, not the old /usr/local path: that would file-conflict with the unowned
  # overlay copy on fielded devices (the scriptlet prunes it instead)
  install -Dm755 "${srcdir}/pocknix-update" "${pkgdir}/usr/bin/pocknix-update"
  install -Dm644 "${srcdir}/pocknix-update.desktop" \
    "${pkgdir}/usr/share/applications/pocknix-update.desktop"
  install -Dm644 "${srcdir}/51-pocknix-update.rules" \
    "${pkgdir}/usr/share/polkit-1/rules.d/51-pocknix-update.rules"
}
