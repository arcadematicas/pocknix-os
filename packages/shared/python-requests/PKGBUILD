# python-requests — Python HTTP for Humans, with its pure-Python deps bundled
# (urllib3, certifi, charset-normalizer, idna). The frozen [pocknix-base] snapshot
# doesn't ship ALARM's [extra] repo, so requests isn't available there; we provide
# it locally (deckstation-arm's setup_arm64_apps.py needs it to fetch aarch64
# AppImages from GitHub/PkgForge).
pkgname=python-requests
pkgver=2.34.2
pkgrel=1
pkgdesc="Python HTTP for Humans (requests + bundled deps: urllib3, certifi, charset-normalizer, idna)"
arch=('aarch64')
url="https://requests.readthedocs.io/"
license=('Apache-2.0')
depends=('python')
options=('!strip')
_wheels=(
  "requests-2.34.2-py3-none-any.whl"
  "urllib3-2.7.0-py3-none-any.whl"
  "certifi-2026.7.22-py3-none-any.whl"
  "charset_normalizer-3.5.1-cp314-cp314-manylinux2014_aarch64.manylinux_2_17_aarch64.manylinux_2_28_aarch64.whl"
  "idna-3.19-py3-none-any.whl"
)
source=(
  "https://files.pythonhosted.org/packages/a0/f4/c67b0b3f1b9245e8d266f0f112c500d50e5b4e83cb6f3b71b6528104182a/requests-2.34.2-py3-none-any.whl"
  "https://files.pythonhosted.org/packages/7f/3e/5db95bcf282c52709639744ca2a8b149baccf648e39c8cc87553df9eae0c/urllib3-2.7.0-py3-none-any.whl"
  "https://files.pythonhosted.org/packages/0b/a7/71ac2cff56fec219ed242bb11b8efb69fcc4bec75db06fb7bfe35de520e6/certifi-2026.7.22-py3-none-any.whl"
  "https://files.pythonhosted.org/packages/f1/5a/0e58b1c04a1596e0256f407274a92d5fb2ee21324409d1fab1da48a65b5b/charset_normalizer-3.5.1-cp314-cp314-manylinux2014_aarch64.manylinux_2_17_aarch64.manylinux_2_28_aarch64.whl"
  "https://files.pythonhosted.org/packages/57/b0/0e52c878c53f245edd3a11020f20979b3f490f245af532c7cae3027754b5/idna-3.19-py3-none-any.whl"
)
sha256sums=(
  '2a0d60c172f83ac6ab31e4554906c0f3b3588d37b5cb939b1c061f4907e278e0'
  '9fb4c81ebbb1ce9531cce37674bbc6f1360472bc18ca9a553ede278ef7276897'
  '62f22742b58a1a33014a2b6b706588a8d7e2a88ae7bd1a6ebe8c992928483775'
  '2f06b7eae9dbe77fe1d644ca244dad508de8d302870a43f3c559b521270938a0'
  '815e7be7a7806d54abb586dc943addc79e8b2ee16915059658cbeff4b1b43bf4'
)
noextract=("${_wheels[@]}")

package() {
  local sitedir
  sitedir="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"
  install -d "${pkgdir}${sitedir}"
  local w
  for w in "${_wheels[@]}"; do
    # a wheel is a zip, so bsdtar unpacks it in place
    bsdtar -xf "${srcdir}/${w}" -C "${pkgdir}${sitedir}"
  done
}