# build output
/build/*
!/build/.gitkeep

# vendored upstream (re-created by `make sync`)
/vendor/*
!/vendor/.gitkeep

# locally built packages
/packages/**/*.pkg.tar.zst
/packages/**/src/
/packages/**/pkg/
# the makepkg srcdir rule above must not swallow the plugin's TypeScript sources
!/packages/shared/pocknix-decky/pocknix-control/src/

# decky plugin frontend build deps (dist/ IS committed — built on the dev Mac, needed by PKGBUILD)
/packages/shared/pocknix-decky/pocknix-control/node_modules/

# local Claude Code settings + context (recreate from pocknix-notes/dev/claude-setup.md)
/.claude/
/CLAUDE.md


# macOS / editor cruft
.DS_Store
*.swp
__pycache__/

# build artifacts (kernel Image, ramdisk) that must never be committed
/out/

# editor/backup cruft
*.bak
*.bak.*

# redundant ADSP blobs. The Odin 3 DTS reads the ADSP from qcom/sm8750/adsp.mbn
# (the committed override in devices/sm8750/firmware/); ayn/odin3/ is only
# referenced for aw883xx_acf.bin (speaker amp), which ships in the ROCKNIX
# firmware overlay. The copies here are leftovers from an earlier wrong guess.
/devices/sm8750/firmware/qcom/sm8750/ayn/
